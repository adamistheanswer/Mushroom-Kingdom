{
   "name": "mushroom-kingdom",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "scripts": {
      "build": "vite build",
      "dev": "cross-env NODE_ENV=development nodemon --watch server --watch server.js --watch vite.config.js --ext js,json --exec node server.js",
      "start": "node server.js",
      "preview": "npm run build && npm run start",
      "format": "prettier --write \"src/**/*.{js,jsx,json,md,ts,tsx,css}\" \"server/**/*.js\" \"*.{js,json,md}\""
   },
   "dependencies": {
      "@msgpack/msgpack": "^3.1.3",
      "@react-three/drei": "^10.7.8",
      "@react-three/fiber": "^9.7.0",
      "dotenv": "^17.4.2",
      "express": "^5.2.1",
      "immer": "^11.1.18",
      "lodash": "^4.18.1",
      "nipplejs": "^1.0.4",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "react-responsive": "^10.0.1",
      "short-unique-id": "^5.3.2",
      "simple-peer": "^9.11.1",
      "simplex-noise": "^4.0.3",
      "styled-components": "^6.5.3",
      "three": "^0.185.1",
      "three-stdlib": "^2.36.1",
      "ws": "^8.21.3",
      "zustand": "^5.0.15"
   },
   "devDependencies": {
      "@types/simple-peer": "^9.11.9",
      "@types/three": "^0.185.4",
      "@vitejs/plugin-react": "^6.1.1",
      "cross-env": "^10.1.0",
      "nodemon": "^3.1.14",
      "prettier": "^3.9.6",
      "vite": "^8.2.2",
      "vite-plugin-node-polyfills": "^0.28.0"
   },
   "engines": {
      "node": ">=20.19.0"
   }
}
